{
  "name": "line-fleet-monitor",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:backend": "npm run dev --prefix apps/backend",
    "build:web": "npm run build -w apps/web",
    "build:backend": "npm run build -w apps/backend"
  }
}
