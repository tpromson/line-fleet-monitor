{
  "name": "@line-fleet/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "report:preview": "tsx --env-file=.env scripts/preview-daily-report.ts",
    "report:test": "tsx --env-file=.env scripts/test-daily-report.ts",
    "report:debug-email": "tsx --env-file=.env scripts/test-resend-debug.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.56.0",
    "@supabase/supabase-js": "^2.49.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "node-cron": "^3.0.3",
    "resend": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  }
}
